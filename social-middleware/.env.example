PORT=3001
#DIFFERENTIATE THE ENVIRONMENT
NODE_ENV=local

#DB CREDENTIALS
MONGO_USER=
MONGO_PASS=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=socialdb
MONGO_URI=mongodb://localhost:27017/socialdb
MONGO_USE_TLS=false

# TEST FEATURES
TEST_KINSHIP=true
TEST_RESOURCE_CASE=true

#BC SERVICE CARD DETAILS
BCSC_CLIENT_ID=
BCSC_CLIENT_SECRET=
BCSC_AUTHORITY=
JWT_SECRET=

#FRONTEND URL
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

# Authentication Configuration
# USE_KONG_OIDC: Set to 'true' to use Kong OIDC plugin authentication (test & production)
#                Set to 'false' to use direct OAuth flow  (local & dev)
USE_KONG_OIDC=false

# MIDDLEWARE_URL: The public URL where this middleware is accessible
# Used for logout redirects to Kong's OIDC logout endpoint
MIDDLEWARE_URL=http://localhost:3001

# Cookie Configuration
# For local development: leave empty or set to localhost
# For test/prod: set to parent domain (e.g., .test.api.gov.bc.ca)
COOKIE_DOMAIN=

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTH_URL=
OAUTH_TOKEN_URL=
OAUTH_REDIRECT_URI=
OAUTH_SCOPE=data

# REDIS Configuration for Queues
# Do not use default port for local deployments if running the forms components as they will overlap
FORM_ACCESS_TOKEN_EXPIRY_MINUTES=30
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=
QUEUE_JOB_ATTEMPTS=16
QUEUE_BACKOFF_DELAY=5000

# CHES Configuration for Email Notifications
CHES_API_URL=
CHES_TOKEN_URL=
CHES_CLIENT_ID=
CHES_CLIENT_SECRET=
CHES_FROM_EMAIL=noreply.caregiverregistry@gov.bc.ca
#DISABLE SENDING EMAILS:
CHES_LIVE=true

# Siebel OAuth Configuration
SIEBEL_TRUSTED_USERNAME=
SIEBEL_CLIENT_ID=

#SIT1
SIEBEL_AUTH_URL=
SIEBEL_TOKEN_URL=
SIEBEL_CLIENT_SECRET=
SIEBEL_APS_BASE_URL=



